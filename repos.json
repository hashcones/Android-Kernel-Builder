[
  {
    "repo": "https://android.googlesource.com/kernel/manifest",
    "branch": "common-android14-6.1",
    "version": "6.1",
    "arch": "arm64",
    "compiler": "clang",
    "clang_version": "r487747c",
    "target": "gki_defconfig",
    "bazel_target": "//common:kernel_aarch64_dist",
    "gki_certification_override": true,
    "nethunter_patch": true,
    "extra_configs": [
      "CONFIG_SYSVIPC=y",
      "CONFIG_BINFMT_MISC=y",
      "CONFIG_CFG80211=m",
      "CONFIG_MAC80211=m",
      "CONFIG_CFG80211_WEXT=y",
      "CONFIG_USB_G_ANDROID=y",
      "CONFIG_USB_F_HID=y",
      "CONFIG_USB_CONFIGFS_F_HID=y"
    ]
  }
]
